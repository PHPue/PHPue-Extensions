<script>
    /* Author(s): Edward Patch */

    // ═══════════ CMS LOGIC ═══════════
    $activeRoute = $_GET['route'] ?? 'blogs';
    $routes = \PHPueExt\PHPueMatrix::listRoutes();
    $pages = \PHPueExt\PHPueMatrix::listPages($activeRoute);
    $theme = \PHPueExt\PHPueMatrix::getTheme('default');
    $themeSections = $theme['sections'] ?? [];
    
    $availableThemes = [];
    $themeDir = __DIR__ . '/backend/phpue-extensions/matrix-cms/themes/';
    $themeFiles = glob($themeDir . '*.php');
    foreach ($themeFiles as $file) {
        $themeName = basename($file, '.php');
        $themeData = include $file;
        $availableThemes[$themeName] = $themeData['meta']['name'] ?? $themeName;
    }
    
    $activeSlug = $_GET['edit'] ?? null;
    $activePage = null;
    
    $fromTemplate = $_GET['from_template'] ?? null;
    if ($fromTemplate && isset($_GET['new'])) {
        $templatePath = __DIR__ . '/backend/phpue-extensions/matrix-cms/pages/templates/' . basename($fromTemplate) . '.php';
        if (file_exists($templatePath)) {
            if (function_exists('opcache_invalidate')) opcache_invalidate($templatePath, true);
            $templateData = include $templatePath;
            if ($templateData) {
                $activePage = $templateData;
                $activePage['slug'] = '';
                $activePage['status'] = 'draft';
            }
        }
    }
    
    if ($activeSlug && !$activePage) {
        $pagePath = __DIR__ . '/backend/phpue-extensions/matrix-cms/pages/' . basename($activeRoute) . '/' . basename($activeSlug) . '.php';
        if (file_exists($pagePath)) {
            if (function_exists('opcache_invalidate')) opcache_invalidate($pagePath, true);
            $activePage = include $pagePath;
        }
    }

    $templates = [];
    $templatesDir = __DIR__ . '/backend/phpue-extensions/matrix-cms/pages/templates/';
    if (is_dir($templatesDir)) {
        foreach (glob($templatesDir . '*.php') as $templateFile) {
            $tplData = include $templateFile;
            $templates[] = [
                'slug' => basename($templateFile, '.php'),
                'title' => $tplData['title'] ?? basename($templateFile, '.php'),
            ];
        }
    }

    @AJAX('POST')
    function saveCmsPage($input)
    {
        $route    = $input['route'] ?? 'blogs';
        $slug     = preg_replace('/[^a-z0-9\-]/', '', $input['slug'] ?? '');
        $theme    = $input['theme'] ?? 'default';
        $title    = $input['title'] ?? 'Untitled';
        $status   = in_array($input['status'] ?? '', ['live', 'draft']) ? $input['status'] : 'draft';
        $sections = $input['sections'] ?? [];
        
        $originalSlug  = $input['originalSlug'] ?? null;
        $originalRoute = $input['originalRoute'] ?? null;

        $seo = [
            'meta_title'       => $input['seo_meta_title'] ?? '',
            'meta_description' => $input['seo_meta_description'] ?? '',
            'meta_keywords'    => $input['seo_meta_keywords'] ?? '',
            'og_title'         => $input['seo_og_title'] ?? '',
            'og_description'   => $input['seo_og_description'] ?? '',
            'og_image'         => $input['seo_og_image'] ?? '',
            'og_type'          => $input['seo_og_type'] ?? 'article',
            'twitter_card'     => $input['seo_twitter_card'] ?? 'summary_large_image',
            'canonical_url'    => $input['seo_canonical_url'] ?? '',
            'noindex'          => !empty($input['seo_noindex']),
        ];

        if (empty($slug) || empty($sections)) {
            http_response_code(400);
            echo json_encode(['error' => 'Slug and at least one section are required']);
            exit;
        }

        $ok = \PHPueExt\PHPueMatrix::createPage($route, $slug, $theme, $sections, $title, $status, $seo);
        
        if ($ok && ($originalSlug || $originalRoute)) {
            $oldRoute = $originalRoute ?? $route;
            $oldSlug = $originalSlug ?? $slug;
            if ($oldRoute !== $route || $oldSlug !== $slug) {
                \PHPueExt\PHPueMatrix::deletePage($oldRoute, $oldSlug);
            }
        }

        echo json_encode(['success' => $ok, 'slug' => $slug, 'route' => $route]);
        exit;
    }

    @AJAX('POST')
    function duplicateCmsPage($input)
    {
        $route = $input['route'] ?? 'blogs';
        $slug  = preg_replace('/[^a-z0-9\-]/', '', $input['slug'] ?? '');
        if (empty($slug)) { http_response_code(400); echo json_encode(['error' => 'Slug required']); exit; }
        
        $pagePath = __DIR__ . '/backend/phpue-extensions/matrix-cms/pages/' . basename($route) . '/' . basename($slug) . '.php';
        if (!file_exists($pagePath)) { http_response_code(404); echo json_encode(['error' => 'Page not found']); exit; }
        
        $data = include $pagePath;
        $newSlug = $slug . '-copy-' . dechex(time());
        $newTitle = ($data['title'] ?? 'Untitled') . ' (Copy)';
        
        $ok = \PHPueExt\PHPueMatrix::createPage($route, $newSlug, $data['theme'] ?? 'default', $data['sections'] ?? [], $newTitle, 'draft', $data['seo'] ?? []);
        echo json_encode(['success' => $ok, 'slug' => $newSlug, 'route' => $route]);
        exit;
    }

    @AJAX('POST')
    function deleteCmsPage($input)
    {
        $route = $input['route'] ?? 'blogs';
        $slug  = preg_replace('/[^a-z0-9\-]/', '', $input['slug'] ?? '');
        if (empty($slug)) { http_response_code(400); echo json_encode(['error' => 'Slug required']); exit; }
        $ok = \PHPueExt\PHPueMatrix::deletePage($route, $slug);
        echo json_encode(['success' => $ok, 'slug' => $slug, 'route' => $route]);
        exit;
    }

    @AJAX('POST')
    function deleteCmsCategory($input)
    {
        $route = basename($input['route'] ?? '');
        if (empty($route) || $route === 'templates') { http_response_code(400); echo json_encode(['error' => 'Invalid category']); exit; }
        
        $dir = __DIR__ . '/backend/phpue-extensions/matrix-cms/pages/' . $route;
        if (!is_dir($dir)) { http_response_code(404); echo json_encode(['error' => 'Category not found']); exit; }

        $files = glob($dir . '/*');
        foreach ($files as $file) {
            if (is_file($file)) unlink($file);
        }
        $ok = rmdir($dir);
        
        echo json_encode(['success' => $ok, 'route' => $route]);
        exit;
    }

    @AJAX('POST')
    function autoSaveDraft($input)
    {
        $route    = $input['route'] ?? 'blogs';
        $slug     = preg_replace('/[^a-z0-9\-]/', '', $input['slug'] ?? '');
        $theme    = $input['theme'] ?? 'default';
        $title    = $input['title'] ?? 'Untitled';
        $status   = in_array($input['status'] ?? '', ['live', 'draft']) ? $input['status'] : 'draft';
        $sections = $input['sections'] ?? [];
        
        $seo = [
            'meta_title'       => $input['seo_meta_title'] ?? '',
            'meta_description' => $input['seo_meta_description'] ?? '',
            'meta_keywords'    => $input['seo_meta_keywords'] ?? '',
            'og_title'         => $input['seo_og_title'] ?? '',
            'og_description'   => $input['seo_og_description'] ?? '',
            'og_image'         => $input['seo_og_image'] ?? '',
            'og_type'          => $input['seo_og_type'] ?? 'article',
            'twitter_card'     => $input['seo_twitter_card'] ?? 'summary_large_image',
            'canonical_url'    => $input['seo_canonical_url'] ?? '',
            'noindex'          => !empty($input['seo_noindex']),
        ];

        if (empty($slug) || empty($sections)) { echo json_encode(['success' => false]); exit; }
        $ok = \PHPueExt\PHPueMatrix::createPage($route, $slug, $theme, $sections, $title, $status, $seo);
        echo json_encode(['success' => $ok, 'slug' => $slug, 'route' => $route]);
        exit;
    }

    @AJAX('POST')
    function getPreview($input)
    {
        $route = $input['route'] ?? 'blogs';
        $slug  = $input['slug'] ?? '';
        if (empty($slug)) { echo '<!DOCTYPE html><html><body style="display:flex;align-items:center;justify-content:center;height:100vh;font-family:sans-serif;color:#999;background:#f9f9f9;"><p>No page to preview</p></body></html>'; exit; }
        $html = \PHPueExt\PHPueMatrix::getPage($route, $slug);
        if (empty($html)) { echo '<!DOCTYPE html><html><body style="display:flex;align-items:center;justify-content:center;height:100vh;font-family:sans-serif;color:#999;background:#f9f9f9;"><p>Page not found</p></body></html>'; exit; }
        echo '<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><link rel="stylesheet" href="/assets/css/tailwind-styles.css"><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"><style>body{margin:0;padding:0;}img{max-width:100%;height:auto;}</style></head><body>' . $html . '</body></html>';
        exit;
    }
</script>

