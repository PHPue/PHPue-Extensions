<!-- Author: Edward Patch -->
<script>
    $slug = $_GET['slug'] ?? null;

    if ($slug) {
        $page = \PHPueExt\PHPueMatrix::getPage('blogs', $slug);
    } else {
        $pages = \PHPueExt\PHPueMatrix::listPages('blogs');
    }
</script>

<header>
    <title>Blog | PHPue</title>
    <meta name="description" content="Articles and insights from the PHPue team">
</header>

<template>
    <?php if (isset($page) && $page): ?>
        <?= $page ?>
    <?php elseif (isset($pages)): ?>
        <div class="min-h-screen bg-stone-50">
            
            <!-- Hero strip -->
            <section class="bg-stone-950 py-16 px-6 text-center">
                <h1 class="text-4xl md:text-5xl font-black text-white tracking-tight">The PHPue Blog</h1>
                <p class="text-stone-400 mt-3 text-lg max-w-xl mx-auto">
                    Thoughts on PHP, flat-file architecture, and building for the web without the bloat.
                </p>
                <div class="mt-6 inline-flex items-center gap-2 px-4 py-2 rounded-full bg-stone-800 text-xs text-stone-400 font-mono">
                    <span class="w-2 h-2 bg-emerald-500 rounded-full"></span>
                    Powered by PHPue Matrix — zero database queries
                </div>
            </section>

            <!-- Post grid -->
            <section class="max-w-5xl mx-auto py-16 px-6">
                <?php 
                $livePages = array_filter($pages, fn($p) => $p['status'] === 'live');
                if (empty($livePages)): 
                ?>
                    <div class="text-center py-20">
                        <div class="w-16 h-16 bg-stone-200 rounded-2xl flex items-center justify-center mx-auto mb-4">
                            <i class="fa-solid fa-pen-to-square text-stone-400 text-xl"></i>
                        </div>
                        <h2 class="text-xl font-semibold text-stone-600">No posts yet</h2>
                        <p class="text-stone-400 text-sm mt-1">Check back soon for articles and insights.</p>
                    </div>
                <?php else: ?>
                    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
                        <?php foreach ($livePages as $p): ?>
                            <a href="/blogs?slug=<?= htmlspecialchars($p['slug']) ?>" 
                               class="group bg-white rounded-2xl overflow-hidden border border-stone-200 hover:border-amber-300 hover:shadow-lg transition-all duration-300 flex flex-col">
                                
                                <!-- Card image placeholder -->
                                <div class="h-40 bg-gradient-to-br from-stone-800 to-stone-700 flex items-center justify-center relative overflow-hidden">
                                    <i class="fa-solid fa-newspaper text-stone-600 text-4xl group-hover:scale-110 transition-transform duration-300"></i>
                                    <div class="absolute top-3 right-3">
                                        <span class="text-xs font-mono text-stone-400 bg-stone-950/60 px-2 py-1 rounded-full backdrop-blur-sm">
                                            <?= htmlspecialchars($p['created']) ?>
                                        </span>
                                    </div>
                                </div>
                                
                                <!-- Card body -->
                                <div class="p-5 flex-1 flex flex-col">
                                    <h2 class="font-bold text-lg text-stone-900 group-hover:text-amber-600 transition-colors leading-snug">
                                        <?= htmlspecialchars($p['title']) ?>
                                    </h2>
                                    <div class="mt-auto pt-4 flex items-center gap-2 text-sm">
                                        <span class="text-amber-600 font-medium group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
                                            Read article <i class="fa-solid fa-arrow-right text-xs"></i>
                                        </span>
                                    </div>
                                </div>
                            </a>
                        <?php endforeach; ?>
                    </div>
                <?php endif; ?>
            </section>

            <!-- Footer -->
            <footer class="border-t border-stone-200 py-8 text-center">
                <p class="text-xs text-stone-400 font-mono">
                    <?= count($livePages) ?> article<?= count($livePages) !== 1 ? 's' : '' ?> · 
                    <span class="text-emerald-600">Flat-file storage</span> · 
                    <a href="https://phpue.co.uk" class="text-purple-500 hover:text-purple-600">Built on PHPue</a>
                </p>
            </footer>
        </div>
    <?php else: ?>
        <section class="min-h-screen flex items-center justify-center bg-stone-50">
            <div class="text-center">
                <div class="w-20 h-20 bg-stone-200 rounded-2xl flex items-center justify-center mx-auto mb-4">
                    <i class="fa-solid fa-circle-exclamation text-stone-400 text-2xl"></i>
                </div>
                <h1 class="text-2xl font-bold text-stone-700">Page not found</h1>
                <p class="text-stone-400 mt-2">The page you're looking for doesn't exist.</p>
