<!-- Author: Edward Patch -->
<script>
    #require 'views/index.pvue';

    // Get Title from seoMetaIndex.php only for index!
    $currentRoute = $_GET['page'] ?? 'index';
    if($currentRoute === 'index' || $currentRoute === '') {
        $pageMeta = PHPueIndexMetaExample::getInstance();
        
        // fetch page title from $pageMeta
        $pageTitle = $pageMeta->getTitle();
    }
    
    // if no $pageMeta, set empty title
    if(!isset($pageMeta)) $pageTitle = '';
</script>

<!-- If you didn't read the README.md: App.pvue is dynamic headers with PHPue Context Aware var outputting, or Static HTML. We can't use PHP unless PHPue has changed since this release. -->
<header>
    <!-- Loads in <title>Page Title Value</title> -->
    {{$pageTitle}}
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
</header>

<template>
    <View></View>
</template>